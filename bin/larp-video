#!/usr/bin/env python3
"""Video steps for larp. Uses ffmpeg and ffprobe.

  larp-video base <session_dir>          join clips without overlaps, drop still frames -> base.mp4
  larp-video frames <video> [every_s]    one JPG every N seconds (default 3) -> frames-<name>/ next to the video
  larp-video render <edl.json>           cut and frame segments -> output video
  larp-video selftest                    check the overlap logic

EDL format:
  {"out": "reel.mp4", "format": "vertical" | "landscape",
   "segments": [{"src": "base.mp4", "start": 0.0, "end": 6.5, "crop": [x, y, w, h]}]}
"crop" is optional, in pixels of the source video.
"""
import json, subprocess, sys, tempfile
from datetime import datetime
from pathlib import Path

SIZES = {"vertical": (1080, 1920), "landscape": (1920, 1080)}
ENC = ["-an", "-r", "30", "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p"]


def run(*args):
    subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *args], check=True)


def duration(path):
    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)],
                         capture_output=True, text=True, check=True).stdout
    return float(out)


def plan(clips):
    """clips: [(save_epoch, duration_s, file)] -> [(file, trim_start_s, save_epoch)] without overlap."""
    kept, covered = [], float("-inf")
    for save, dur, f in sorted(clips, key=lambda c: c[0] - c[1]):  # by start time
        trim = max(0.0, covered - (save - dur))
        if trim < dur - 0.5:  # skip clips that are fully (or almost fully) inside earlier ones
            kept.append((f, trim, save))
        covered = max(covered, save)
    return kept


def concat(parts, out):
    with tempfile.NamedTemporaryFile("w", suffix=".txt", delete=False) as lst:
        lst.writelines(f"file '{Path(p).resolve()}'\n" for p in parts)
    run("-f", "concat", "-safe", "0", "-i", lst.name, "-c", "copy", str(out))
    Path(lst.name).unlink()


def cmd_base(session):
    s = Path(session)
    clips = []
    for line in (s / "clips.tsv").read_text().splitlines():
        saved, _, f = line.split("\t")
        if Path(f).exists():
            clips.append((datetime.fromisoformat(saved).timestamp(), duration(f), f))
    tmp = Path(tempfile.mkdtemp(dir=s))
    parts, index, t = [], [], 0.0
    for i, (f, trim, save) in enumerate(plan(clips)):
        part = tmp / f"part{i:03d}.mp4"
        run("-ss", f"{trim:.2f}", "-i", f, "-vf", "mpdecimate,setpts=N/FRAME_RATE/TB", *ENC, str(part))
        d = duration(part)
        index.append({"base_start": round(t, 2), "base_end": round(t + d, 2), "clip": f,
                      "saved_at": datetime.fromtimestamp(save).isoformat(timespec="seconds")})
        parts.append(part)
        t += d
    concat(parts, s / "base.mp4")
    for p in parts:
        p.unlink()
    tmp.rmdir()
    (s / "base.json").write_text(json.dumps({"duration": round(t, 2), "parts": index}, indent=1))
    print(json.dumps({"base": str(s / "base.mp4"), "duration": round(t, 2), "parts": len(index)}))


def cmd_frames(video, every=3.0):
    v = Path(video)
    out = v.parent / f"frames-{v.stem}"
    out.mkdir(exist_ok=True)
    for old in out.glob("*.jpg"):
        old.unlink()
    run("-i", str(v), "-vf", f"fps=1/{every},scale=960:-2", str(out / "%04d.jpg"))
    w = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
                        "-of", "csv=p=0", str(v)], capture_output=True, text=True, check=True).stdout.strip()
    print(f"source size {w.replace(',', 'x')}, frames scaled to 960 px wide")
    for i, f in enumerate(sorted(out.glob("*.jpg"))):
        print(f"{f}  t={i * every:.1f}s")


def compose(w, h, crop):
    fg = f"crop={crop[2]}:{crop[3]}:{crop[0]}:{crop[1]}," if crop else ""
    return (f"[0:v]split[a][b];"
            f"[a]scale={w}:{h}:force_original_aspect_ratio=increase,crop={w}:{h},boxblur=30:3,eq=brightness=-0.15[bg];"
            f"[b]{fg}scale={w}:{h}:force_original_aspect_ratio=decrease:force_divisible_by=2[fg];"
            f"[bg][fg]overlay=(W-w)/2:(H-h)/2,setsar=1")


def cmd_render(edl_path):
    edl_path = Path(edl_path)
    edl = json.loads(edl_path.read_text())
    w, h = SIZES[edl["format"]]
    base = edl_path.parent
    tmp = Path(tempfile.mkdtemp(dir=base))
    parts = []
    for i, seg in enumerate(edl["segments"]):
        part = tmp / f"seg{i:03d}.mp4"
        run("-ss", str(seg["start"]), "-to", str(seg["end"]), "-i", str(base / seg["src"]),
            "-filter_complex", compose(w, h, seg.get("crop")), *ENC, str(part))
        parts.append(part)
    out = base / edl["out"]
    concat(parts, out)
    for p in parts:
        p.unlink()
    tmp.rmdir()
    print(json.dumps({"out": str(out), "duration": round(duration(out), 2)}))


def selftest():
    # 60 s clip saved at t=100, then a 30 s clip at t=110: only the last 10 s of the second are new.
    assert plan([(100, 60, "a"), (110, 30, "b")]) == [("a", 0.0, 100), ("b", 20.0, 110)]
    # A 30 s clip fully inside a 300 s clip saved later is dropped.
    assert plan([(400, 300, "big"), (200, 30, "small")]) == [("big", 0.0, 400)]
    assert plan([(100, 30, "a"), (100.2, 30, "dup")]) == [("a", 0.0, 100)]
    # Gaps between clips keep the whole clip.
    assert plan([(100, 30, "a"), (500, 30, "b")]) == [("a", 0.0, 100), ("b", 0.0, 500)]
    print("ok")


if __name__ == "__main__":
    a = sys.argv[1:]
    if a[:1] == ["base"] and len(a) == 2:
        cmd_base(a[1])
    elif a[:1] == ["frames"] and len(a) in (2, 3):
        cmd_frames(a[1], float(a[2]) if len(a) == 3 else 3.0)
    elif a[:1] == ["render"] and len(a) == 2:
        cmd_render(a[1])
    elif a[:1] == ["selftest"]:
        selftest()
    else:
        sys.exit(__doc__)
